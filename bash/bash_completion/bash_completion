# file: bash_completion
# bash_completion parameter completion
# created by bashrc on startup

function _bash_completion () {
	local cur prev opts fileopts diropts keywords
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"
	prev2="${COMP_WORDS[COMP_CWORD-2]}"
	opts="-w -a"
	fileopts="-a"
	diropts="-w"

	words=""

	case "${prev}" in
		bash_completion)
			words="-w -a"
			;;
		-w)
			cd ~/dot/screen/bash_completions
			rc=( $(compgen -f -- ${cur}) )
			COMPREPLY=( ${rc[@]%.*} )
			return 0
			;;
		*)
			words="-a"
			;;
	esac
	COMPREPLY=( $(compgen -W "$words" -- $cur) )
}
complete -F _bash_completion bash_completion
