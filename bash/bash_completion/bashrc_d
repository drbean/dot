# file: bashrc_d
# bashrc_d parameter completion
# created by bashrc on startup

function _bashrc_d () {
	local cur prev opts fileopts diropts keywords
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"
	prev2="${COMP_WORDS[COMP_CWORD-2]}"
	opts="-w -a"
	fileopts="-a"
	diropts="-w"

	words=""

	case "${prev}" in
		bashrc_d)
			words="-w -a"
			;;
		-w)
			cd ~/dot/screen/bashrc_ds
			rc=( $(compgen -f -- ${cur}) )
			COMPREPLY=( ${rc[@]%.*} )
			return 0
			;;
		*)
			words="-a"
			;;
	esac
	COMPREPLY=( $(compgen -W "$words" -- $cur) )
}
complete -F _bashrc_d bashrc_d
