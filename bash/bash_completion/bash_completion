# file: bash_completion
# shortcut parameter completion
# copied from shortcut

app=bash_completion

function _$app () {
	local cur prev opts fileopts diropts keywords
	COMPREPLY=()
	cur="${COMP_WORDS[COMP_CWORD]}"
	prev="${COMP_WORDS[COMP_CWORD-1]}"
	prev2="${COMP_WORDS[COMP_CWORD-2]}"
	opts="-w -a"
	fileopts="-a"
	diropts="-w"

	words=""

	# if [[ ${prev} =~ ${fileopts} ]]; then
	# COMPREPLY=( $(compgen -f -- ~/profstowit/${cur}) )
	# return 0
	# elif [[ ${prev} =~ ${diropts} ]]; then
	# COMPREPLY=( $(compgen -d -- ~/profstowit/${cur}) )
	# return 0
	# fi

	case "${prev}" in
		"${app}")
			words="-w -a"
			;;
		-w)
			cd ~/dot/screen/${app}s
			rc=( $(compgen -f -- ${cur}) )
			COMPREPLY=( ${rc[@]%.*} )
			return 0
			;;
		*)
			words="-a"
			;;
	esac
	COMPREPLY=( $(compgen -W "$words" -- $cur) )
}
complete -F _${app} "${app}"
